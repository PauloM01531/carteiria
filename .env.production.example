# Modelo para PRODUÇÃO. Copie para .env.production NO SERVIDOR e preencha. Nunca publique o arquivo preenchido.
# Gere cada senha/chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------- Domínio e HTTPS ----------
DOMAIN=carteiria.exemplo.com.br
ACME_EMAIL=seu-email@exemplo.com.br
HTTP_PORT=80
HTTPS_PORT=443

# ---------- Banco ----------
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_USER=carteiria_owner
DB_OWNER_PASSWORD=
DB_APP_USER=carteiria_app
DB_APP_PASSWORD=
DB_NAME=carteiria

# ---------- API ----------
ENVIRONMENT=production
SECRET_KEY=
FRONTEND_ORIGINS=https://carteiria.exemplo.com.br
FRONTEND_URL=https://carteiria.exemplo.com.br
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# ---------- E-mail (provedor SMTP real, ex.: Brevo, Resend, Amazon SES) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=CarteirIA <nao-responda@carteiria.exemplo.com.br>
