# Copie para .env (na raiz do projeto) e preencha. NUNCA publique o .env.
# Os valores abaixo são exemplos para desenvolvimento local, não credenciais reais.

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_SUPERUSER_PASSWORD=troque-esta-senha-superusuario
# Dono das tabelas: usado SOMENTE para migrações (Alembic) e scripts administrativos do servidor.
DB_OWNER_USER=carteiria_owner
DB_OWNER_PASSWORD=troque-esta-senha-owner
# Usuário da aplicação: sem BYPASSRLS, sem ser dono das tabelas (RLS se aplica a ele).
DB_APP_USER=carteiria_app
DB_APP_PASSWORD=troque-esta-senha-app
# Use 127.0.0.1 (no Windows, "localhost" pode tentar IPv6 e travar)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=carteiria
DB_TEST_NAME=carteiria_test

# ---------- Backend ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-um-valor-aleatorio-longo
ENVIRONMENT=development
# Origens do frontend permitidas (CORS e verificação de Origin), separadas por vírgula
FRONTEND_ORIGINS=http://localhost:5173
# URL pública do frontend (usada nos links enviados por e-mail)
FRONTEND_URL=http://localhost:5173
# Em produção (HTTPS) deve ser true
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# ---------- E-mail (SMTP) ----------
# Em desenvolvimento o docker-compose sobe o Mailpit (caixa de entrada local em http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=CarteirIA <nao-responda@carteiria.local>
